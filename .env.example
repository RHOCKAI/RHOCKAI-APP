# Use unique random values locally and in production.
DB_PASSWORD=replace_with_a_long_random_alphanumeric_password
DATABASE_URL=postgresql+psycopg2://workout_user:replace_with_a_long_random_alphanumeric_password@postgres:5432/workout_tracker
SECRET_KEY=replace_with_a_long_random_secret_key
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080# ============================================
